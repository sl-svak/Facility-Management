# 1. Zákaz procházení obsahu složky
Options -Indexes

# 2. Zákaz spouštění jakýchkoliv skriptů (PHP, Python, Perl, CGI)
<FilesMatch "\.(php|php[3-7]|phtml|pl|py|jsp|asp|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Vynucení stažení/zobrazení pouze povolených typů (ochrana proti MIME-sniffingu)
<FilesMatch "(?i)\.(jpe?g|png|gif|pdf|csv)$">
    Header set X-Content-Type-Options "nosniff"
</FilesMatch>